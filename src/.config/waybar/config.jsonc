{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 4,
    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "custom/ip_target"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/vpn",
        "custom/ip",
        "tray",
        "privacy",
        "bluetooth",
        "wireplumber",
        "network",
        "battery"
    ],
    "battery": {
        "bat": "BAT0",
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{capacity}% {icon}",
        "format-plugged": "{capacity}% ",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "max-length": 6,
        "on-click": "$HOME/.config/waybar/powerMenu.sh"
    },
    "bluetooth": {
        "format": "",
        "format-off": "",
        "format-on": "",
        "format-connected": "",
        "max-length": 4,
        "on-click": "blueman-manager",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "* {device_alias}",
        "tooltip-format-enumerate-connected-battery": "* {device_alias} ({device_battery_percentage}%)"
    },
    "clock": {
        "format": "{:%F %R}",
        "format-alt": "{:%a %b %e %Y %R}",
        "tooltip": true,
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            },
            "actions": {
                "on-click-right": "mode",
                "on-scroll-up": "shift_up",
                "on-scroll-down": "shift_down"
            }
        }
    },
    "custom/arch": {
        "format": "󰣇 ",
        "max-length": 3,
        "tooltip": false,
        "on-click": "fuzzel"
    },
    "custom/ip": {
        "exec": "source $HOME/.config/waybar/ip.sh; getHostIp",
        "interval": 5,
        "format": "{}  ",
        "max-length": 20,
        "on-click": "source $HOME/.config/waybar/ip.sh; copyHostIp",
        "tooltip": false
    },
    "custom/ip_target": {
        "exec": "source $HOME/.config/waybar/ip.sh; getTargetIp",
        "interval": 5,
        "format": "  {}",
        "max-length": 20,
        "on-click": "source $HOME/.config/waybar/ip.sh; copyTargetIp",
        "tooltip": false
    },
    "custom/vpn": {
        "exec": "source $HOME/.config/waybar/ip.sh; getVpnIp",
        "interval": 5,
        "format": "{} 󰆧 ",
        "max-length": 20,
        "on-click": "source $HOME/.config/waybar/ip.sh; copyVpnIp",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 10
        },
        "sort-by": "id"
    },
    "network": {
        "interface": "wlp2s0",
        "format-ethernet": " ",
        "format-wifi": " ",
        "format-disconnected": "󰖪 ",
        "format-disabled": "󰖪 ",
        "max-length": 4,
        "on-click": "nm-connection-editor",
        "tooltip-format": "{essid} ({signalStrength}%)"
    },
    "privacy": {
        "icon-spacing": 2,
        "icon-size": 16
    },
    "tray": {
        "icon-size": 16,
        "show-passive-items": true,
        "spacing": 2
    },
    "wireplumber": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": [
            "",
            "",
            ""
        ],
        "on-click": "pavucontrol",
        "tooltip-format": "{node_name} ({volume}%)"
    }
}
