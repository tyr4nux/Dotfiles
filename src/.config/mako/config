sort=-time
font=Sans 11
background-color=#00000099
padding=10
border-radius=12
format=<b><u>%a</u> ⏵ %s</b>\n%b
default-timeout=5000
max-visible=5
layer=overlay
anchor=top-right

# Low notifications
border-color=#00FF00
progress-color=over #00FF00

# Normal notifications
[urgency=normal]
border-color=#FFFF00
progress-color=over #FFFF00

# Critical notifications
[urgency=high]
border-color=#FF0000
progress-color=#FF0000
default-timeout=0
